{
    "name":  "hermes-agent-webui",
    "version":  "1.2.0",
    "private":  true,
    "description":  "Hermes Agent WebUI launcher package",
    "scripts":  {
                    "postinstall":  "npm --prefix backend install",
                    "start":  "npm --prefix backend start",
                    "dev":  "npm --prefix backend run dev",
                    "health":  "node -e \"fetch(\u0027http://127.0.0.1:\u0027+(process.env.PORT||3381)+\u0027/api/health\u0027).then(r=\u003e{console.log(r.status);process.exit(r.ok?0:1)}).catch(e=\u003e{console.error(e.message);process.exit(1)})\""
                },
    "engines":  {
                    "node":  "\u003e=18.0.0"
                }
}
